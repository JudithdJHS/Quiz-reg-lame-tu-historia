# MailerLite
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID_A=            # Secuencia A — Crisis
MAILERLITE_GROUP_ID_B=            # Secuencia B — Exploración
MAILERLITE_GROUP_ID_C=            # Secuencia C — Crecimiento

# Google Sheets
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=               # Incluir \n tal como está en el JSON

# Gmail / Nodemailer
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL_RECIPIENT=hola@regalametuhistoria.com

# URLs de productos RTH
NEXT_PUBLIC_URL_TALLER=https://www.regalametuhistoria.com/?utm_source=ig&utm_medium=social&utm_content=link_in_bio
NEXT_PUBLIC_URL_MEMBRESIA=https://regalametuhistoria.systeme.io/membresiaparasanar2?utm_source=ig&utm_medium=social&utm_content=link_in_bio

# Skool Webhook
SKOOL_WEBHOOK_SECRET=             # Secreto para verificar webhooks de Skool
MAILERLITE_GROUP_ID_COMPRADORES=191357617025582681  # ID del grupo "Compradores Taller" en MailerLite

# Zapier → Skool (invitación automática con acceso al curso tras pago aprobado)
ZAPIER_SKOOL_INVITE_WEBHOOK_URL=  # URL del "Catch Hook" del Zap (Webhooks by Zapier → Skool "Invite with custom course access"). Requiere plan Skool Pro.

# Sistema Anti-fuga — grupos de estado en MailerLite
MAILERLITE_GROUP_ID_CHECKOUT_INICIADO=   # Grupo "Estado — Checkout Iniciado"
MAILERLITE_GROUP_ID_PAGO_FALLIDO=        # Grupo "Estado — Pago Fallido"

# Wompi (cuenta de RTH — crear en comercios.wompi.co y copiar de Configuración → Llaves API)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=     # pub_prod_... (o pub_test_... para pruebas)
WOMPI_INTEGRITY_SECRET=           # Secreto de integridad (firma del widget)
WOMPI_EVENTS_SECRET=              # Secreto de eventos (verificación del webhook)
WOMPI_AMOUNT_IN_CENTS=            # Precio del taller en centavos (ej: 88000000 = $880.000 COP)
WOMPI_CURRENCY=COP

# Acceso al taller (email post-compra)
URL_SKOOL_TALLER=                 # Link de invitación al grupo Skool del taller

# Sesiones 1:1 (Google Calendar — página de citas de Google Workspace)
NEXT_PUBLIC_URL_AGENDA_1_1=       # Link de la página de reservas de citas de Ana y Alex

# Panel /admin (CRM interno)
ADMIN_USERS=                      # Multi-admin: "Nombre:clave, Nombre2:clave2" — recomendado
ADMIN_PASSWORD=                   # Fallback de un solo admin (se loguea como "Equipo") si no usas ADMIN_USERS
ADMIN_SESSION_SECRET=             # Secreto aleatorio largo para firmar la cookie de sesión

# App
NEXT_PUBLIC_APP_URL=              # URL de Vercel o http://localhost:3000
